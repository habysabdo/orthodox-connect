/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, AccessKey, VideoId, LibraryId

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# The push worker must be revalidated too, so an updated OneSignal worker is
# picked up instead of being served from a stale cache for a year.
/OneSignalSDKWorker.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/assets/*
  Cache-Control: public, max-age=31536000, immutable
